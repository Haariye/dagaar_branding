{
 "doctype": "Custom HTML Block",
 "html": "<!--\n  ╔══════════════════════════════════════════════════════════════╗\n  ║  PATIENT LABORATORY QUEUE — TODAY                           ║\n  ║  Item Group: Laboratory                                     ║\n  ║  ERPNext Workspace Custom HTML Block                        ║\n  ║                                                             ║\n  ║  Paste this ENTIRE content into Workspace > Custom HTML     ║\n  ╚══════════════════════════════════════════════════════════════╝\n-->\n\n<iframe\n  id=\"lab-draft-queue-frame\"\n  scrolling=\"no\"\n  style=\"width:100%;border:none;min-height:120px;display:block;overflow:hidden;border-radius:12px;\"\n  srcdoc='\n<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<style>\n  @import url(\"https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap\");\n\n  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }\n\n  html, body { overflow: hidden; height: auto; }\n\n  body {\n    font-family: \"DM Sans\", -apple-system, BlinkMacSystemFont, sans-serif;\n    background: transparent;\n    color: #1a1d26;\n    -webkit-font-smoothing: antialiased;\n  }\n\n  .queue-wrapper {\n    background: linear-gradient(135deg, #ffffff 0%, #f8f9fc 100%);\n    border: 1px solid #e2e5f1;\n    border-radius: 12px;\n    overflow: hidden;\n  }\n\n  /* ── Header ── */\n  .queue-header {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    padding: 16px 20px;\n    background: linear-gradient(135deg, #1b2a4a 0%, #26395e 100%);\n    color: #fff;\n  }\n  .queue-header-left {\n    display: flex;\n    align-items: center;\n    gap: 10px;\n  }\n  .queue-header-icon {\n    width: 34px; height: 34px;\n    background: rgba(255,255,255,0.12);\n    border-radius: 8px;\n    display: flex; align-items: center; justify-content: center;\n    font-size: 16px;\n  }\n  .queue-header h2 {\n    font-size: 14px;\n    font-weight: 700;\n    letter-spacing: 0.3px;\n    margin: 0;\n  }\n  .queue-header-sub {\n    font-size: 11px;\n    opacity: 0.7;\n    font-weight: 400;\n    margin-top: 1px;\n  }\n  .queue-badge {\n    background: rgba(255,255,255,0.15);\n    border: 1px solid rgba(255,255,255,0.2);\n    border-radius: 20px;\n    padding: 4px 14px;\n    font-size: 12px;\n    font-weight: 600;\n    display: flex; align-items: center; gap: 6px;\n  }\n  .queue-badge .dot {\n    width: 7px; height: 7px;\n    background: #5eead4;\n    border-radius: 50%;\n    animation: pulse-dot 2s ease-in-out infinite;\n  }\n  @keyframes pulse-dot {\n    0%, 100% { opacity: 1; transform: scale(1); }\n    50% { opacity: 0.5; transform: scale(0.8); }\n  }\n\n  .today-tag {\n    background: rgba(94,234,212,0.2);\n    border: 1px solid rgba(94,234,212,0.3);\n    border-radius: 6px;\n    padding: 3px 10px;\n    font-size: 11px;\n    font-weight: 600;\n    color: #5eead4;\n    margin-left: 10px;\n  }\n\n  .refresh-btn {\n    background: rgba(255,255,255,0.1);\n    border: 1px solid rgba(255,255,255,0.15);\n    border-radius: 6px;\n    color: #fff;\n    width: 30px; height: 30px;\n    display: flex; align-items: center; justify-content: center;\n    cursor: pointer;\n    font-size: 14px;\n    transition: all 0.2s;\n    margin-left: 10px;\n  }\n  .refresh-btn:hover { background: rgba(255,255,255,0.2); }\n  .refresh-btn.spinning svg { animation: spin 0.8s linear infinite; }\n  @keyframes spin { to { transform: rotate(360deg); } }\n\n  /* ── Summary bar ── */\n  .summary-bar {\n    display: flex;\n    gap: 0;\n    border-bottom: 1px solid #e2e5f1;\n    background: #f1f3f9;\n  }\n  .summary-item {\n    flex: 1;\n    padding: 12px 16px;\n    text-align: center;\n    border-right: 1px solid #e2e5f1;\n  }\n  .summary-item:last-child { border-right: none; }\n  .summary-item .val {\n    font-size: 20px;\n    font-weight: 700;\n    color: #1b2a4a;\n    line-height: 1;\n  }\n  .summary-item .lbl {\n    font-size: 10px;\n    text-transform: uppercase;\n    letter-spacing: 0.5px;\n    color: #7c8db5;\n    font-weight: 600;\n    margin-top: 4px;\n  }\n\n  /* ── Patient list ── */\n  .patient-list {\n    padding: 6px 10px 10px;\n    max-height: 290px;\n    overflow-y: auto;\n  }\n\n  .patient-row {\n    display: flex;\n    align-items: center;\n    padding: 10px 12px;\n    border-radius: 8px;\n    transition: background 0.15s, transform 0.1s;\n    gap: 12px;\n    cursor: pointer;\n    user-select: none;\n  }\n  .patient-row:hover { background: #e8ebf4; }\n  .patient-row:active { background: #dde1f0; transform: scale(0.995); }\n\n  .patient-rank {\n    width: 24px; height: 24px;\n    border-radius: 6px;\n    background: #eef0f6;\n    color: #7c8db5;\n    font-size: 11px;\n    font-weight: 700;\n    display: flex; align-items: center; justify-content: center;\n    flex-shrink: 0;\n  }\n  .patient-row:nth-child(1) .patient-rank { background: #fef3c7; color: #92400e; }\n  .patient-row:nth-child(2) .patient-rank { background: #e0e7ff; color: #4338ca; }\n  .patient-row:nth-child(3) .patient-rank { background: #d1fae5; color: #065f46; }\n\n  .patient-avatar {\n    width: 36px; height: 36px;\n    border-radius: 50%;\n    color: #fff;\n    font-size: 13px;\n    font-weight: 700;\n    display: flex; align-items: center; justify-content: center;\n    flex-shrink: 0;\n    text-transform: uppercase;\n  }\n\n  .patient-info {\n    flex: 1;\n    min-width: 0;\n  }\n  .patient-info .pname {\n    font-size: 13px;\n    font-weight: 600;\n    color: #1a1d26;\n    white-space: nowrap;\n    overflow: hidden;\n    text-overflow: ellipsis;\n  }\n  .patient-info .pid {\n    font-size: 11px;\n    color: #8896b3;\n    font-weight: 500;\n    margin-top: 1px;\n    white-space: nowrap;\n    overflow: hidden;\n    text-overflow: ellipsis;\n  }\n\n  .test-count-badge {\n    flex-shrink: 0;\n    padding: 4px 12px;\n    border-radius: 20px;\n    font-size: 12px;\n    font-weight: 700;\n    background: #fee2e2;\n    color: #b91c1c;\n    min-width: 50px;\n    text-align: center;\n  }\n  .test-count-badge.medium { background: #fef3c7; color: #92400e; }\n  .test-count-badge.low { background: #e0e7ff; color: #4338ca; }\n\n  .row-arrow {\n    flex-shrink: 0;\n    font-size: 18px;\n    font-weight: 300;\n    color: #b0bdd5;\n    transition: transform 0.15s, color 0.15s;\n    margin-left: 2px;\n  }\n  .patient-row:hover .row-arrow { color: #6366f1; transform: translateX(2px); }\n\n  /* ── States ── */\n  .state-msg {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    padding: 40px 20px;\n    text-align: center;\n  }\n  .state-msg .icon { font-size: 28px; margin-bottom: 10px; }\n  .state-msg .title { font-size: 14px; font-weight: 600; color: #1a1d26; }\n  .state-msg .desc { font-size: 12px; color: #8896b3; margin-top: 4px; max-width: 260px; }\n\n  .loader-bar {\n    height: 3px;\n    background: #e2e5f1;\n    overflow: hidden;\n    border-radius: 3px;\n    width: 140px;\n    margin-top: 14px;\n  }\n  .loader-bar::after {\n    content: \"\";\n    display: block;\n    height: 100%;\n    width: 40%;\n    background: #6366f1;\n    border-radius: 3px;\n    animation: slide 1s ease-in-out infinite;\n  }\n  @keyframes slide {\n    0% { transform: translateX(-100%); }\n    100% { transform: translateX(350%); }\n  }\n\n  .error-retry {\n    margin-top: 10px;\n    padding: 6px 18px;\n    border-radius: 6px;\n    border: 1px solid #e2e5f1;\n    background: #fff;\n    font-size: 12px;\n    font-weight: 600;\n    color: #1b2a4a;\n    cursor: pointer;\n    transition: all 0.15s;\n  }\n  .error-retry:hover { background: #f0f2fa; }\n\n  .timestamp {\n    text-align: center;\n    font-size: 10px;\n    color: #a0aec0;\n    padding: 6px 0 10px;\n  }\n</style>\n</head>\n<body>\n\n<div class=\"queue-wrapper\">\n  <!-- Header -->\n  <div class=\"queue-header\">\n    <div class=\"queue-header-left\">\n      <div class=\"queue-header-icon\">&#x1F9EA;</div>\n      <div>\n        <h2>Patient Laboratory Queue</h2>\n        <div class=\"queue-header-sub\">Today&rsquo;s pending lab tests grouped by patient</div>\n      </div>\n    </div>\n    <div style=\"display:flex;align-items:center;\">\n      <div class=\"today-tag\" id=\"todayTag\">TODAY</div>\n      <div class=\"queue-badge\"><span class=\"dot\"></span> <span id=\"hdr-badge\">LIVE</span></div>\n      <button class=\"refresh-btn\" id=\"refreshBtn\" title=\"Refresh\">\n        <svg width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"23 4 23 10 17 10\"/><path d=\"M20.49 15a9 9 0 1 1-2.12-9.36L23 10\"/></svg>\n      </button>\n    </div>\n  </div>\n\n  <!-- Summary -->\n  <div class=\"summary-bar\" id=\"summaryBar\" style=\"display:none;\">\n    <div class=\"summary-item\"><div class=\"val\" id=\"sumPatients\">0</div><div class=\"lbl\">Patients</div></div>\n    <div class=\"summary-item\"><div class=\"val\" id=\"sumTests\">0</div><div class=\"lbl\">Pending Tests</div></div>\n    <div class=\"summary-item\"><div class=\"val\" id=\"sumAvg\">0</div><div class=\"lbl\">Avg / Patient</div></div>\n  </div>\n\n  <!-- Content area -->\n  <div id=\"content\">\n    <div class=\"state-msg\">\n      <div class=\"icon\">&#x23F3;</div>\n      <div class=\"title\">Loading draft lab tests&hellip;</div>\n      <div class=\"desc\">Fetching records from the server</div>\n      <div class=\"loader-bar\"></div>\n    </div>\n  </div>\n\n  <div class=\"timestamp\" id=\"tsLine\" style=\"display:none;\"></div>\n</div>\n\n<script>\n(function(){\n  var frappe = window.parent && window.parent.frappe;\n\n  var contentEl  = document.getElementById(\"content\");\n  var summaryBar = document.getElementById(\"summaryBar\");\n  var tsLine     = document.getElementById(\"tsLine\");\n  var refreshBtn = document.getElementById(\"refreshBtn\");\n\n  function resizeFrame() {\n    try {\n      var h = document.querySelector(\".queue-wrapper\").offsetHeight;\n      if (h > 50 && window.frameElement) {\n        window.frameElement.style.height = h + \"px\";\n      }\n    } catch(e){}\n  }\n\n  function getToday() {\n    var d = new Date();\n    var mm = (\"0\" + (d.getMonth()+1)).slice(-2);\n    var dd = (\"0\" + d.getDate()).slice(-2);\n    return d.getFullYear() + \"-\" + mm + \"-\" + dd;\n  }\n\n  // Show today date in the tag\n  var todayTag = document.getElementById(\"todayTag\");\n  if (todayTag) {\n    var d = new Date();\n    todayTag.textContent = d.toLocaleDateString(undefined, { month: \"short\", day: \"numeric\", year: \"numeric\" });\n  }\n\n  function showError(msg) {\n    summaryBar.style.display = \"none\";\n    tsLine.style.display = \"none\";\n    contentEl.innerHTML =\n      \"<div class=\\\"state-msg\\\">\" +\n        \"<div class=\\\"icon\\\">&#x26A0;&#xFE0F;</div>\" +\n        \"<div class=\\\"title\\\">Could not load data</div>\" +\n        \"<div class=\\\"desc\\\">\" + msg + \"</div>\" +\n        \"<button class=\\\"error-retry\\\" onclick=\\\"window._fetchQueue()\\\">Retry</button>\" +\n      \"</div>\";\n    setTimeout(resizeFrame, 50);\n  }\n\n  function showEmpty() {\n    summaryBar.style.display = \"none\";\n    tsLine.style.display = \"none\";\n    contentEl.innerHTML =\n      \"<div class=\\\"state-msg\\\">\" +\n        \"<div class=\\\"icon\\\">&#x2705;</div>\" +\n        \"<div class=\\\"title\\\">All clear!</div>\" +\n        \"<div class=\\\"desc\\\">No laboratory tests pending for today.</div>\" +\n      \"</div>\";\n    setTimeout(resizeFrame, 50);\n  }\n\n  function getInitials(name) {\n    if (!name) return \"?\";\n    var parts = name.trim().split(/\\s+/);\n    if (parts.length >= 2) return (parts[0][0] + parts[parts.length-1][0]).toUpperCase();\n    return parts[0].substring(0,2).toUpperCase();\n  }\n\n  function badgeClass(count) {\n    if (count >= 5) return \"test-count-badge\";\n    if (count >= 3) return \"test-count-badge medium\";\n    return \"test-count-badge low\";\n  }\n\n  var avatarColors = [\n    [\"#6366f1\",\"#818cf8\"],[\"#8b5cf6\",\"#a78bfa\"],[\"#ec4899\",\"#f472b6\"],\n    [\"#14b8a6\",\"#2dd4bf\"],[\"#f59e0b\",\"#fbbf24\"],[\"#ef4444\",\"#f87171\"],\n    [\"#3b82f6\",\"#60a5fa\"],[\"#10b981\",\"#34d399\"]\n  ];\n\n  function avatarGrad(idx) {\n    var c = avatarColors[idx % avatarColors.length];\n    return \"linear-gradient(135deg,\" + c[0] + \",\" + c[1] + \")\";\n  }\n\n  function renderPatients(grouped) {\n    if (!grouped.length) { showEmpty(); return; }\n\n    grouped.sort(function(a,b){ return b.count - a.count; });\n\n    var totalTests = 0;\n    grouped.forEach(function(g){ totalTests += g.count; });\n    var avg = (totalTests / grouped.length).toFixed(1);\n\n    document.getElementById(\"sumPatients\").textContent = grouped.length;\n    document.getElementById(\"sumTests\").textContent = totalTests;\n    document.getElementById(\"sumAvg\").textContent = avg;\n    summaryBar.style.display = \"flex\";\n\n    var html = \"<div class=\\\"patient-list\\\">\";\n    grouped.forEach(function(g, i){\n      var url = \"/app/lab-test?docstatus=0&status=Draft&patient=\" + encodeURIComponent(g.patient);\n      html +=\n        \"<div class=\\\"patient-row\\\" data-url=\\\"\" + url + \"\\\">\" +\n          \"<div class=\\\"patient-rank\\\">\" + (i+1) + \"</div>\" +\n          \"<div class=\\\"patient-avatar\\\" style=\\\"background:\" + avatarGrad(i) + \"\\\">\" + getInitials(g.patient_name) + \"</div>\" +\n          \"<div class=\\\"patient-info\\\">\" +\n            \"<div class=\\\"pname\\\">\" + (g.patient_name || \"Unknown\") + \"</div>\" +\n            \"<div class=\\\"pid\\\">\" + (g.id_number || g.patient || \"\") + \"</div>\" +\n          \"</div>\" +\n          \"<div class=\\\"\" + badgeClass(g.count) + \"\\\">\" + g.count + \" test\" + (g.count>1?\"s\":\"\") + \"</div>\" +\n          \"<div class=\\\"row-arrow\\\">&#x203A;</div>\" +\n        \"</div>\";\n    });\n    html += \"</div>\";\n    contentEl.innerHTML = html;\n\n    // Attach click handlers\n    var rows = contentEl.querySelectorAll(\".patient-row\");\n    for (var i = 0; i < rows.length; i++) {\n      rows[i].addEventListener(\"click\", function() {\n        try { window.parent.location.href = this.getAttribute(\"data-url\"); } catch(e) { window.top.location.href = this.getAttribute(\"data-url\"); }\n      });\n    }\n\n    var now = new Date();\n    tsLine.textContent = \"Last updated: \" + now.toLocaleTimeString();\n    tsLine.style.display = \"block\";\n    setTimeout(resizeFrame, 50);\n  }\n\n  function fetchQueue() {\n    if (!frappe || !frappe.call) {\n      showError(\"Frappe API not available. Ensure you are logged in to ERPNext.\");\n      return;\n    }\n\n    contentEl.innerHTML =\n      \"<div class=\\\"state-msg\\\">\" +\n        \"<div class=\\\"icon\\\">&#x23F3;</div>\" +\n        \"<div class=\\\"title\\\">Loading laboratory tests&hellip;</div>\" +\n        \"<div class=\\\"desc\\\">Fetching today&rsquo;s records</div>\" +\n        \"<div class=\\\"loader-bar\\\"></div>\" +\n      \"</div>\";\n    refreshBtn.classList.add(\"spinning\");\n\n    var today = getToday();\n    var tomorrow = (function(){ var t = new Date(); t.setDate(t.getDate()+1); var mm=(\"0\"+(t.getMonth()+1)).slice(-2); var dd=(\"0\"+t.getDate()).slice(-2); return t.getFullYear()+\"-\"+mm+\"-\"+dd; })();\n\n    // Step 1: Get all enabled Lab Test Templates\n    frappe.call({\n      method: \"frappe.client.get_list\",\n      args: {\n        doctype: \"Lab Test Template\",\n        filters: { disabled: 0 },\n        fields: [\"name\",\"item\"],\n        limit_page_length: 0\n      },\n      async: true,\n      callback: function(tplRes) {\n        var templates = (tplRes && tplRes.message) ? tplRes.message : [];\n        if (!templates.length) { refreshBtn.classList.remove(\"spinning\"); showEmpty(); return; }\n\n        var itemCodes = [];\n        templates.forEach(function(t){ if(t.item) itemCodes.push(t.item); });\n        if (!itemCodes.length) { refreshBtn.classList.remove(\"spinning\"); showEmpty(); return; }\n\n        // Step 2: Filter items to item_group = Laboratory\n        frappe.call({\n          method: \"frappe.client.get_list\",\n          args: {\n            doctype: \"Item\",\n            filters: { name: [\"in\", itemCodes], item_group: \"Laboratory\" },\n            fields: [\"name\"],\n            limit_page_length: 0\n          },\n          async: true,\n          callback: function(itemRes) {\n            var items = (itemRes && itemRes.message) ? itemRes.message : [];\n            if (!items.length) { refreshBtn.classList.remove(\"spinning\"); showEmpty(); return; }\n\n            var labItems = {};\n            items.forEach(function(it){ labItems[it.name] = true; });\n\n            var validTemplates = [];\n            templates.forEach(function(t){ if (t.item && labItems[t.item]) validTemplates.push(t.name); });\n            if (!validTemplates.length) { refreshBtn.classList.remove(\"spinning\"); showEmpty(); return; }\n\n            // Step 3: Get draft Lab Tests for today only\n            frappe.call({\n              method: \"frappe.client.get_list\",\n              args: {\n                doctype: \"Lab Test\",\n                filters: {\n                  docstatus: 0,\n                  status: \"Draft\",\n                  template: [\"in\", validTemplates],\n                  creation: [\"between\", [today, tomorrow]]\n                },\n                fields: [\"name\",\"patient\",\"patient_name\",\"custom_identification_number\"],\n                limit_page_length: 0,\n                order_by: \"creation desc\"\n              },\n              async: true,\n              callback: function(r) {\n                refreshBtn.classList.remove(\"spinning\");\n                if (!r || !r.message) { showEmpty(); return; }\n                var records = r.message;\n                if (!records.length) { showEmpty(); return; }\n\n                var map = {};\n                records.forEach(function(rec){\n                  var key = rec.patient || rec.name;\n                  if (!map[key]) {\n                    map[key] = {\n                      patient: rec.patient || \"\",\n                      patient_name: rec.patient_name || \"\",\n                      id_number: rec.custom_identification_number || rec.patient || \"\",\n                      count: 0\n                    };\n                  }\n                  map[key].count++;\n                });\n                var grouped = [];\n                for (var k in map) { grouped.push(map[k]); }\n                renderPatients(grouped);\n              },\n              error: function() { refreshBtn.classList.remove(\"spinning\"); showError(\"Error fetching lab tests.\"); }\n            });\n          },\n          error: function() { refreshBtn.classList.remove(\"spinning\"); showError(\"Error fetching items.\"); }\n        });\n      },\n      error: function(err) {\n        refreshBtn.classList.remove(\"spinning\");\n        var msg = \"Server error.\";\n        if (err && err.message) msg = err.message;\n        showError(msg);\n      }\n    });\n  }\n\n  window._fetchQueue = fetchQueue;\n  refreshBtn.addEventListener(\"click\", function(){ fetchQueue(); });\n  setInterval(fetchQueue, 60000);\n\n  new MutationObserver(function(){ resizeFrame(); }).observe(\n    document.querySelector(\".queue-wrapper\"), { childList: true, subtree: true }\n  );\n\n  setTimeout(fetchQueue, 500);\n  setTimeout(resizeFrame, 200);\n})();\n</script>\n\n</body>\n</html>\n'></iframe>\n\n<!-- Fallback resize if outer script executes -->\n<script>\n(function(){\n  var f = document.getElementById('lab-draft-queue-frame');\n  if (!f) return;\n  function r(){ try { var h = f.contentDocument.body.scrollHeight; if(h>50) f.style.height=h+'px'; } catch(e){} }\n  setInterval(r, 800);\n  f.addEventListener('load', function(){ setTimeout(r, 400); });\n})();\n</script>\n",
 "name": "Patient Laboratory Queue",
 "private": 0,
 "roles": [
  {
   "role": "All"
  }
 ],
 "script": "",
 "style": ""
}